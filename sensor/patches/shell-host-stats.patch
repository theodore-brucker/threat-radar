+def _human_kib(kib: int) -> str:
+    """A KiB figure the way procps-ng 4 prints it with -h (threat-radar)."""
+    if kib <= 0:
+        return "0B"
+    value, units, i = float(kib), ["Ki", "Mi", "Gi", "Ti"], 0
+    while value >= 1024 and i < len(units) - 1:
+        value /= 1024
+        i += 1
+    return f"{value:.1f}{units[i]}" if value < 10 else f"{int(value)}{units[i]}"
+
