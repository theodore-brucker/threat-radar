diff --git a/src/cowrie/core/utils.py b/src/cowrie/core/utils.py
index c3f69ba..503f524 100644
--- a/src/cowrie/core/utils.py
+++ b/src/cowrie/core/utils.py
@@ -90,6 +90,42 @@ def tail(the_file: BinaryIO, lines_2find: int = 20) -> list[bytes]:
     # 21 to ensure we don't get a half line
 
 
+# --- threat-radar host stats (begin) ---
+# cowrie.service runs with ProcSubset=pid, so the host's /proc/uptime,
+# /proc/loadavg and /proc/meminfo cannot be read from inside it. A root timer
+# on the sensor copies them into honeyfs, and these read them from there, so
+# uptime, w, free and cat agree with each other.
+def _honeyfs_text(relpath: str) -> str:
+    from cowrie.shell.honeyfs import read_honeyfs_bytes
+
+    try:
+        return read_honeyfs_bytes(relpath).decode("ascii", "replace")
+    except Exception:
+        return ""
+
+
+def host_uptime() -> float | None:
+    try:
+        return float(_honeyfs_text("proc/uptime").split()[0])
+    except (IndexError, ValueError):
+        return None
+
+
+def host_loadavg() -> str:
+    fields = _honeyfs_text("proc/loadavg").split()[:3]
+    try:
+        return ", ".join(f"{float(v):.2f}" for v in fields) if len(fields) == 3 else "0.00, 0.00, 0.00"
+    except ValueError:
+        return "0.00, 0.00, 0.00"
+
+
+def host_meminfo_lines() -> list[str]:
+    return _honeyfs_text("proc/meminfo").splitlines()
+
+
+# --- threat-radar host stats (end) ---
+
+
