+    def positional(self) -> list[str]:
+        """The positional parameters $1, $2 and so on (threat-radar patch)."""
+        values: list[str] = []
+        while str(len(values) + 1) in self.environ:
+            values.append(self.environ[str(len(values) + 1)])
+        return values
+
+    def set_positional(self, values: list[str]) -> None:
+        """Replace the positional parameters, as `set --` does."""
+        for name in [key for key in self.environ if key.isdigit()]:
+            del self.environ[name]
+        for number, value in enumerate(values, start=1):
+            self.environ[str(number)] = value
+        self.environ["#"] = str(len(values))
+        self.environ["@"] = " ".join(values)
+        self.environ["*"] = " ".join(values)
+
+    def become_process(self, name: str) -> None:
+        """Mark this shell as a new process, the way `sh -c` starts one: it
+        has its own process id and no positional parameters."""
