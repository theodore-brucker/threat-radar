+def owning_shell(command: HoneyPotCommand) -> Any:
+    """threat-radar patch: the shell a builtin was typed into, or None when
+    something else started the command."""
+    stack = command.protocol.cmdstack
+    shell = stack[-2] if len(stack) > 1 else None
+    return shell if hasattr(shell, "set_positional") else None
+
