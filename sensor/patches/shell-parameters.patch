+class Command_shift(HoneyPotCommand):
+    """threat-radar patch: drop the first N positional parameters."""
+
+    def call(self) -> None:
+        shell = owning_shell(self)
+        if shell is None:
+            return
+        current = shell.positional()
+        count = 1
+        if self.args:
+            if not self.args[0].isdigit():
+                self.errorWrite(
+                    f"-bash: shift: {self.args[0]}: numeric argument required\n"
+                )
+                self.exit_code = 1
+                return
+            count = int(self.args[0])
+        if count > len(current):
+            self.exit_code = 1
+            return
+        shell.set_positional(current[count:])
+
+
+commands["shift"] = Command_shift
+
