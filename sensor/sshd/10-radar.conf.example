# /etc/ssh/sshd_config.d/10-radar.conf
#
# Real SSH moves off 22 so Cowrie can have it, and listens only on the tailnet
# address, so the administrative path is never exposed to the internet.
#
# The only account that logs in here is the one the log pull uses. Its key
# lives in a root-owned authorized_keys file rather than under the account's
# own home, because that account is the honeypot process: if it could edit its
# own authorized_keys it could remove the forced command, and if it could edit
# the forced command it could decide what the collector receives.
#
# Replace the listen address with this host's tailnet address before use.

Port 2200
ListenAddress <sensor-tailnet-ip>:2200

PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no

AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no

# Administrative access arrives through Tailscale SSH rather than this daemon,
# so the pull account is the only one that needs it. Removing this line is the
# fallback if Tailscale SSH is ever unavailable and the provider console is
# not an option.
AllowUsers cowrie

Match User cowrie
    AuthorizedKeysFile /etc/ssh/authorized_keys/cowrie
    DisableForwarding yes
    PermitTTY no
