[Unit]
Description=Threat Radar intel team publisher (knowledge base push, issues, daily mail)
After=network-online.target radar-team.service
Wants=network-online.target
# A failed send is retried every ten minutes, four times at most.
StartLimitIntervalSec=3600
StartLimitBurst=4

[Service]
Type=oneshot
User=radar-team-pub
Group=radar-team-pub
WorkingDirectory=/opt/threat-radar
# The repository name and the mail addresses. No secrets.
EnvironmentFile=/etc/threat-radar/team-pub.env
# Root-owned files that only this account's units are handed.
LoadCredential=github-token:/etc/threat-radar/team-pub/github-token
LoadCredential=smtp-password:/etc/threat-radar/team-pub/smtp-password
Environment=TR_APP=/opt/threat-radar
Environment=TR_TEAM_STATE=/var/lib/radar-team
Environment=TR_TEAM_PUB_STATE=/var/lib/radar-team-pub
Environment=TR_TEAM_KB=/var/lib/radar-team-pub/kb
Environment=HOME=/var/lib/radar-team-pub
# The clone and the sent markers. Group-readable so the worker, which has
# radar-team-pub as a supplementary group, can read the clone.
StateDirectory=radar-team-pub
StateDirectoryMode=0750
# To read the worker's outbox.
SupplementaryGroups=radar-team
ExecStart=/opt/threat-radar/venv/bin/python /opt/threat-radar/bin/team_publish.py publish
Restart=on-failure
RestartSec=600
TimeoutStartSec=900

# Hardening. This unit reaches GitHub and the mail server.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

[Install]
WantedBy=multi-user.target
