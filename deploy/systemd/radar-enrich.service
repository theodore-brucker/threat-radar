[Unit]
Description=Threat Radar enricher
After=radar-ingest.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=radar
Group=radar
WorkingDirectory=/opt/threat-radar
Environment=TR_BASE=/opt/threat-radar
ExecStart=/opt/threat-radar/venv/bin/python /opt/threat-radar/enrich.py
Restart=always
RestartSec=10

# Hardening. Geolocation reads the MaxMind databases from /var/lib/GeoIP,
# which stays readable under ProtectSystem=strict, and needs no network of
# its own.
ReadWritePaths=/opt/threat-radar/data
IPAddressDeny=any
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
UMask=0027

[Install]
WantedBy=multi-user.target
