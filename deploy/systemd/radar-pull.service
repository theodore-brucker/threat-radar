[Unit]
Description=Pull Cowrie logs from the sensor

[Service]
Type=oneshot
User=radar
Group=radar
WorkingDirectory=/opt/threat-radar
EnvironmentFile=/etc/threat-radar/pull.env
Environment=TR_BASE=/opt/threat-radar
# Must match the prune unit. The pull only requests rotated files newer than
# this, so a file the prune has deleted is never fetched again while the
# sensor still lists it.
Environment=TR_SPOOL_RETAIN_DAYS=8
ExecStart=/opt/threat-radar/pull.sh
# RuntimeMaxSec has no effect on a oneshot unit, which is what the installed
# copy used, so nothing has been bounding a stalled pull. TimeoutStartSec is
# the setting that applies here.
TimeoutStartSec=90
# The lock lives here rather than in the repo, which the service account no
# longer owns. pull.sh reads RUNTIME_DIRECTORY and falls back to /tmp when it
# is run by hand.
RuntimeDirectory=threat-radar
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

# Hardening. Everything this receives comes from a host that is meant to be
# attacked, so it writes only to the spool. The sensor's host key is pinned in
# the known-hosts file with StrictHostKeyChecking=yes, so that file is only
# ever read.
ReadWritePaths=/opt/threat-radar/spool
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
